---
import fs from "node:fs";
import path from "node:path";
import { getCollection } from "astro:content";
import { getArticleDescription } from "../content/articles/descriptions";
import { getLocalizedArticleEntry } from "../content/articles/localized";
import { getArticleSlug, getEventLabel, sessions, years, topics } from "../content/sessions/data";
import { articlesDefaultLang, formatArticleTemplate, getArticlesLocale } from "../i18n/articles";
import { getLocalizedPath } from "../i18n/routing";
import type { ArticlesLangCode } from "../i18n/articles";
import SearchBox from "./SearchBox.astro";
import YearFilter from "./YearFilter.astro";
import TopicFilter from "./TopicFilter.astro";
import MobileFilterToggle from "./MobileFilterToggle.astro";
import SidebarOverlay from "./SidebarOverlay.astro";

interface Props {
  lang?: ArticlesLangCode;
}

const { lang = articlesDefaultLang } = Astro.props;
const t = getArticlesLocale(lang);
const articleBasePath = getLocalizedPath("/articles", lang);
const articles = await getCollection("articles");

const localizedSessions = sessions.flatMap((session) => {
  const slug = getArticleSlug(session);
  const localizedArticle = getLocalizedArticleEntry(articles, slug, lang);
  if (!localizedArticle) return [];

  const articleDescription = getArticleDescription(
    localizedArticle.data.description,
    localizedArticle.body,
    lang,
  );

  return [{
    ...session,
    title: localizedArticle.data.title,
    description: articleDescription,
  }];
});
const localizedYearCounts = Object.fromEntries(
  years.map((year) => [year, localizedSessions.filter((session) => session.year === year).length]),
);
const localizedTopicCounts = Object.fromEntries(
  topics.map((topic) => [
    topic.id,
    localizedSessions.filter((session) => session.primaryTopic === topic.id).length,
  ]),
);
const initialSessionCount = formatArticleTemplate(t.sessionCount, { count: localizedSessions.length });

const coversDir = path.resolve(process.cwd(), "public/images/sessions");
const existingCovers = new Set();
if (fs.existsSync(coversDir)) {
  for (const yearEntry of fs.readdirSync(coversDir, { withFileTypes: true })) {
    if (!yearEntry.isDirectory()) continue;
    const yearDir = path.join(coversDir, yearEntry.name);
    for (const fileEntry of fs.readdirSync(yearDir, { withFileTypes: true })) {
      if (fileEntry.isFile() && fileEntry.name.endsWith(".jpg")) {
        existingCovers.add(`/images/sessions/${yearEntry.name}/${fileEntry.name}`);
      }
    }
  }
}
---

<div class="session-browser">
  <div class="browser-toolbar">
    <div class="browser-heading">
      <h1 class="content-title" id="contentTitle">{t.contentTitleAll}</h1>
      <span class="content-count" id="contentCount">{initialSessionCount}</span>
    </div>
    <div class="browser-actions">
      <SearchBox placeholder={t.searchPlaceholder} />
      <MobileFilterToggle label={t.mobileFilters} />
    </div>
  </div>

  <div class="layout">
    <aside class="sidebar" id="sidebar">
      <YearFilter lang={lang} totalCount={localizedSessions.length} counts={localizedYearCounts} />
      <TopicFilter lang={lang} totalCount={localizedSessions.length} counts={localizedTopicCounts} />
    </aside>

    <SidebarOverlay />

    <main class="content">
      <div class="session-grid" id="sessionGrid" data-article-base-path={articleBasePath}>
        <div class="loading">
          <div class="spinner"></div>
          {t.loading}
        </div>
      </div>
    </main>
  </div>
</div>

<script define:vars={{ sessionsData: localizedSessions, yearsData: years, yearCountsData: localizedYearCounts, topicsData: topics, copyData: t, articleBasePath, existingCoversData: [...existingCovers] }}>
  const sessions = sessionsData;
  const years = yearsData;
  const existingCovers = new Set(existingCoversData);
  const yearCounts = yearCountsData;
  const topics = topicsData;
  const copy = copyData;

  const urlParams = new URLSearchParams(window.location.search);
  let activeYear = urlParams.get('year') || 'all';
  let activeTopic = urlParams.get('topic') || 'all';
  let searchQuery = urlParams.get('q') || '';

  function syncURL() {
    const params = new URLSearchParams();
    if (activeYear !== 'all') params.set('year', activeYear);
    if (activeTopic !== 'all') params.set('topic', activeTopic);
    if (searchQuery) params.set('q', searchQuery);
    const qs = params.toString();
    const url = window.location.pathname + (qs ? '?' + qs : '');
    history.replaceState(null, '', url);
  }

  function format(template, values = {}) {
    return String(template || '').replace(/\{(\w+)\}/g, (_match, key) => String(values[key] ?? ''));
  }

  function t(key, values = {}) {
    const str = copy?.[key];
    if (!str) return key;
    return format(str, values);
  }

  function esc(str) {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function getGradient(topicId) {
    const topic = topics.find(t => t.id === topicId);
    const c = topic ? topic.color : ['#667eea', '#764ba2'];
    return `linear-gradient(135deg, ${c[0]} 0%, ${c[1]} 100%)`;
  }

  function getThumbnailUrl(session) {
    return `/images/sessions/${session.year}/${session.contentId}.jpg`;
  }

  function getEventLabel(year) {
    return year === 'tech-talks' ? 'Tech Talks' : `WWDC${year.slice(2)}`;
  }

  function getArticleSlug(session) {
    return session.year === 'tech-talks'
      ? `tech-talks-${session.contentId}`
      : `wwdc${session.year}-${session.contentId}`;
  }

  function renderCards(filtered) {
    const grid = document.getElementById('sessionGrid');
    if (filtered.length === 0) {
      grid.innerHTML = `
        <div class="empty-state">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
          <h3>${esc(t('emptyTitle'))}</h3>
          <p>${esc(t('emptyDesc'))}</p>
        </div>
      `;
      return;
    }

    grid.innerHTML = filtered.map(s => {
      const topic = topics.find(t => t.id === s.primaryTopic);
      const topicTitle = topic ? topic.title : s.primaryTopic;
      const gradient = getGradient(s.primaryTopic);
      const thumbUrl = getThumbnailUrl(s);
      const hasImage = existingCovers.has(thumbUrl);
      const thumbImage = hasImage
        ? `<img src="${esc(thumbUrl)}" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
        : '';
      const fallbackDisplay = hasImage ? 'none' : 'flex';
      const eventLabel = getEventLabel(s.year);
      const resLabel = s.resources > 0
        ? `<span>📄 ${s.resources} ${esc(t('cardResources'))}</span>` : '';
      const codeLabel = s.codeSnippets > 0
        ? `<span>💻 ${s.codeSnippets} ${esc(t('cardCode'))}</span>` : '';

      const articleSlug = getArticleSlug(s);

      return `
        <a class="session-card" href="${articleBasePath}/${esc(articleSlug)}">
          <div class="card-cover" style="background:${gradient}">
            ${thumbImage}
            <span class="cover-fallback" style="display:${fallbackDisplay}">${esc(s.contentId)}</span>
            <span class="card-year-badge">${esc(eventLabel)}</span>
            <span class="card-topic-badge">${esc(topicTitle)}</span>
          </div>
          <div class="card-body">
            <div class="card-title">${esc(s.title)}</div>
            <div class="card-desc">${esc(s.description)}</div>
            <div class="card-meta">${resLabel}${codeLabel}</div>
          </div>
        </a>
      `;
    }).join('');
  }

  function updateTopicCounts() {
    const base = activeYear !== 'all' ? sessions.filter(s => s.year === activeYear) : sessions;
    const allCountEl = document.querySelector('#topicFilters .filter-item[data-topic="all"] .filter-count');
    if (allCountEl) allCountEl.textContent = String(base.length);
    topics.forEach(topic => {
      const count = base.filter(s => s.primaryTopic === topic.id).length;
      const el = document.querySelector(`#topicFilters .filter-item[data-topic="${topic.id}"] .filter-count`);
      if (el) el.textContent = String(count);
    });
  }

  function updateResults() {
    syncURL();
    updateTopicCounts();
    let filtered = sessions;
    if (activeYear !== 'all') filtered = filtered.filter(s => s.year === activeYear);
    if (activeTopic !== 'all') filtered = filtered.filter(s => s.primaryTopic === activeTopic);
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter(s =>
        s.title.toLowerCase().includes(q) ||
        s.description.toLowerCase().includes(q) ||
        s.contentId.includes(q)
      );
    }

    const titleEl = document.getElementById('contentTitle');
    if (activeYear === 'all' && activeTopic === 'all' && !searchQuery) {
      titleEl.textContent = t('contentTitleAll');
    } else if (searchQuery) {
      titleEl.textContent = t('contentTitleSearch', { query: searchQuery });
    } else if (activeYear !== 'all' && activeTopic !== 'all') {
      const tName = topics.find(t => t.id === activeTopic)?.title || activeTopic;
      titleEl.textContent = t('contentTitleYearTopic', { eventLabel: getEventLabel(activeYear), topic: tName });
    } else if (activeYear !== 'all') {
      titleEl.textContent = t('contentTitleYear', { eventLabel: getEventLabel(activeYear) });
    } else {
      const tName = topics.find(t => t.id === activeTopic)?.title || activeTopic;
      titleEl.textContent = t('contentTitleTopic', { topic: tName });
    }

    document.getElementById('contentCount').textContent = t('sessionCount', { count: filtered.length });

    renderCards(filtered);
  }

  function renderFilters() {
    // Year filters
    document.querySelectorAll('#yearFilters .filter-item').forEach(item => {
      item.addEventListener('click', e => {
        e.preventDefault();
        activeYear = item.dataset.year;
        document.querySelectorAll('#yearFilters .filter-item').forEach(el =>
          el.classList.toggle('active', el.dataset.year === activeYear));
        document.querySelectorAll('#yearFilters input').forEach(el => el.checked = el.value === activeYear);
        updateResults();
      });
    });

    // Topic filters
    document.querySelectorAll('#topicFilters .filter-item').forEach(item => {
      item.addEventListener('click', e => {
        e.preventDefault();
        activeTopic = item.dataset.topic;
        document.querySelectorAll('#topicFilters .filter-item').forEach(el =>
          el.classList.toggle('active', el.dataset.topic === activeTopic));
        document.querySelectorAll('#topicFilters input').forEach(el => el.checked = el.value === activeTopic);
        updateResults();
      });
    });
  }

  // Search
  document.getElementById('searchInput')?.addEventListener('input', e => {
    searchQuery = e.target.value.trim();
    updateResults();
  });

  // Mobile sidebar
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebarOverlay');
  document.getElementById('mobileFilterToggle')?.addEventListener('click', () => {
    sidebar?.classList.toggle('mobile-open');
    overlay?.classList.toggle('open');
  });
  overlay?.addEventListener('click', () => {
    sidebar?.classList.remove('mobile-open');
    overlay?.classList.remove('open');
  });

  // Init - restore UI from URL state
  document.querySelectorAll('#yearFilters .filter-item').forEach(el =>
    el.classList.toggle('active', el.dataset.year === activeYear));
  document.querySelectorAll('#yearFilters input').forEach(el => el.checked = el.value === activeYear);
  document.querySelectorAll('#topicFilters .filter-item').forEach(el =>
    el.classList.toggle('active', el.dataset.topic === activeTopic));
  document.querySelectorAll('#topicFilters input').forEach(el => el.checked = el.value === activeTopic);
  const searchInput = document.getElementById('searchInput');
  if (searchInput && searchQuery) searchInput.value = searchQuery;

  renderFilters();
  updateResults();
</script>

<style is:global>
  .session-browser {
    --blue: #2782fb;
    --orange: #fb6131;
    --ink: #0b0b0f;
    --slate: #737682;
    --mist: #f5f6f8;
    --paper: #ffffff;
    --line: #e4e7ee;
    --line-strong: #ced5e2;
    --surface: rgba(255, 255, 255, 0.72);
    --text: #0b0b0f;
    --text-secondary: #737682;
    --text-muted: #9ca3af;
    --border: rgba(228, 231, 238, 0.92);
    --border-light: #f3f4f6;
    --accent: #2782fb;
    --accent-hover: #0051d5;
    --shadow-sm: 0 2px 8px rgba(11, 11, 15, 0.04);
    --shadow: 0 4px 16px rgba(11, 11, 15, 0.06);
    --shadow-md: 0 8px 32px rgba(11, 11, 15, 0.08);
    --shadow-lg: 0 16px 48px rgba(39, 130, 251, 0.09);
    --radius-sm: 10px;
    --radius: 16px;
    --radius-lg: 22px;
    --sidebar-width: 220px;
    min-height: 100vh;
    color: var(--ink);
    line-height: 1.5;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
    padding-bottom: 40px;
  }

  .session-browser,
  .session-browser * {
    box-sizing: border-box;
  }

  /* ── Toolbar ── */
  .browser-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 480px);
    align-items: center;
    gap: 22px;
    margin: 24px 0 18px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(248, 250, 255, 0.82)),
      radial-gradient(circle at 0% 50%, rgba(251, 97, 49, 0.1), transparent 18rem);
    box-shadow: 0 18px 54px rgba(31, 39, 51, 0.08);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .browser-heading,
  .browser-actions {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .browser-heading {
    gap: 12px;
    padding-left: 8px;
  }

  .browser-actions {
    justify-content: flex-end;
    gap: 10px;
  }

  /* ── Layout ── */
  .layout {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    gap: 18px;
    padding: 0 0 24px;
  }

  /* ── Sidebar ── */
  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    position: sticky;
    top: 90px;
    height: calc(100vh - 110px);
    overflow-y: auto;
    scrollbar-width: thin;
    background: var(--surface);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px 16px;
    box-shadow: var(--shadow);
  }
  .sidebar::-webkit-scrollbar { width: 4px; }
  .sidebar::-webkit-scrollbar-thumb { background: var(--line); border-radius: 4px; }

  .filter-section { margin-bottom: 24px; }
  .filter-section:last-child { margin-bottom: 0; }
  .filter-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 10px;
    padding-left: 4px;
  }
  .filter-group { display: flex; flex-direction: column; gap: 2px; }
  .filter-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    font-size: 0.82rem;
    color: var(--slate);
    user-select: none;
  }
  .filter-item:hover {
    background: rgba(39, 130, 251, 0.05);
    color: var(--ink);
  }
  .filter-item.active {
    background: rgba(39, 130, 251, 0.1);
    color: var(--accent);
    font-weight: 600;
  }
  .filter-item input {
    width: 14px;
    height: 14px;
    accent-color: var(--accent);
    cursor: pointer;
    flex-shrink: 0;
  }
  .filter-item .filter-label {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .filter-item .filter-count {
    font-size: 0.7rem;
    color: var(--text-muted);
    flex-shrink: 0;
    font-weight: 500;
  }
  .filter-item.active .filter-count { color: var(--accent); }

  /* ── Content ── */
  .content { min-width: 0; }
  .content-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.2;
  }
  .content-count {
    flex: 0 0 auto;
    padding: 6px 10px;
    border: 1px solid rgba(206, 213, 226, 0.72);
    border-radius: 999px;
    color: #596171;
    background: rgba(255, 255, 255, 0.76);
    font-size: 0.76rem;
    font-weight: 720;
    line-height: 1;
  }

  /* ── Session Grid ── */
  .session-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .session-card {
    display: block;
    background: var(--paper);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }
  .session-card:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: var(--shadow-lg);
  }

  .card-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }
  .card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .session-card:hover .card-cover img { transform: scale(1.05); }
  .card-cover .cover-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.9);
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }
  .card-topic-badge {
    position: absolute;
    bottom: 10px;
    left: 10px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    letter-spacing: 0.02em;
  }
  .card-year-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .card-body { padding: 16px 18px 18px; }
  .card-title {
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }
  .card-desc {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--slate);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--border-light);
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .card-meta span { display: flex; align-items: center; gap: 4px; }

  /* ── Search Box ── */
  .search-box {
    position: relative;
    width: min(100%, 420px);
    min-width: 260px;
    flex: 1 1 320px;
  }
  .search-box input {
    width: 100%;
    height: 46px;
    padding: 0 44px 0 17px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    font-size: 0.88rem;
    color: var(--ink);
    outline: none;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }
  .search-box input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(39, 130, 251, 0.12), var(--shadow);
  }
  .search-box input::placeholder { color: var(--text-muted); }
  .search-box svg {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 17px;
    height: 17px;
    color: var(--text-muted);
    pointer-events: none;
  }

  /* ── Empty State ── */
  .empty-state {
    text-align: center;
    padding: 80px 20px;
    color: var(--text-muted);
    grid-column: 1 / -1;
    background: var(--surface);
    backdrop-filter: blur(18px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .empty-state svg { width: 48px; height: 48px; margin-bottom: 16px; opacity: 0.5; }
  .empty-state h3 { font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 8px; }
  .empty-state p { font-size: 0.875rem; }

  /* ── Loading ── */
  .loading {
    text-align: center;
    padding: 60px;
    color: var(--text-muted);
    grid-column: 1 / -1;
    background: var(--surface);
    backdrop-filter: blur(18px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .spinner { width: 32px; height: 32px; border: 3px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 16px; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Sidebar Overlay ── */
  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    z-index: 150;
    backdrop-filter: blur(4px);
  }
  .sidebar-overlay.open { display: block; }
  .sidebar.mobile-open {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    z-index: 200;
    background: var(--paper);
    padding: 20px;
    box-shadow: var(--shadow-lg);
  }

  /* ── Mobile Filter Toggle ── */
  .mobile-filter-toggle {
    display: none;
    background: var(--surface);
    backdrop-filter: blur(18px);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 12px 16px;
    font-size: 0.85rem;
    color: var(--slate);
    cursor: pointer;
    font-weight: 600;
    box-shadow: var(--shadow-sm);
    transition: all 0.15s ease;
  }
  .mobile-filter-toggle:hover {
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .browser-toolbar {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .browser-actions {
      justify-content: stretch;
    }

