---
import { getEventLabel, getGradient, getThumbnailUrl } from "../content/sessions/data";
import type { Session } from "../content/sessions/data";
import { topics } from "../content/sessions/data";

interface Props {
  session: Session;
}

const { session } = Astro.props;

const topic = topics.find((t) => t.id === session.primaryTopic);
const topicTitle = topic ? topic.title : session.primaryTopic;
const gradient = getGradient(session.primaryTopic);
const thumbUrl = getThumbnailUrl(session);
const eventLabel = getEventLabel(session.year);
---

<a
  class="session-card"
  href={session.permalink}
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="card-cover" style={`background: ${gradient}`}>
    {thumbUrl && (
      <img
        src={thumbUrl}
        alt=""
        loading="lazy"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
      />
    )}
    <span
      class="cover-fallback"
      style={thumbUrl ? "display:none" : ""}
    >
      {session.contentId}
    </span>
    <span class="card-year-badge">{eventLabel}</span>
    <span class="card-topic-badge">{topicTitle}</span>
  </div>
  <div class="card-body">
    <div class="card-title">{session.title}</div>
    <div class="card-desc">{session.description}</div>
    <div class="card-meta">
      {session.resources > 0 && (
        <span>📄 {session.resources} resources</span>
      )}
      {session.codeSnippets > 0 && (
        <span>💻 {session.codeSnippets} code</span>
      )}
    </div>
  </div>
</a>
