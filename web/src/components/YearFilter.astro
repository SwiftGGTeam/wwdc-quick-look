---
import { getEventLabel, years } from "../content/sessions/data";
import { articlesDefaultLang, getArticlesLocale } from "../i18n/articles";
import type { ArticlesLangCode } from "../i18n/articles";

interface Props {
  lang?: ArticlesLangCode;
  totalCount?: number;
  counts?: Record<string, number>;
}

const { lang = articlesDefaultLang, totalCount = 0, counts = {} } = Astro.props;
const t = getArticlesLocale(lang);
---

<div class="filter-section">
  <div class="filter-title" data-art-i18n="filterYear">{t.filterYear}</div>
  <div class="filter-group" id="yearFilters">
    <label class="filter-item active" data-year="all">
      <input type="radio" name="year" value="all" checked />
      <span class="filter-label" data-art-i18n="filterAll">{t.filterAll}</span>
      <span class="filter-count">{totalCount}</span>
    </label>
    {years.map((year) => (
      <label class="filter-item" data-year={year}>
        <input type="radio" name="year" value={year} />
        <span class="filter-label">{getEventLabel(year)}</span>
        <span class="filter-count">{counts[year] || 0}</span>
      </label>
    ))}
  </div>
</div>
